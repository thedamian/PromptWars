# Copy to .env and fill in your values.
OPENAI_APIKEY=sk-...
# Model used to build the contestant websites (needs strong HTML/CSS skills).
OPENAI_MODEL_OPEN=gpt-5.6-terra
# Model used for prompt screening and for judging screenshots (must accept image input).
OPENAI_MODEL_INTERACT=gpt-5.6-luna

# Optional
PORT=3000
# Round length in seconds (default 300 = 5 minutes)
ROUND_SECONDS=300
# How long the leaderboard is displayed between rounds (seconds)
RESULTS_SECONDS=60
# URL encoded in the QR code
PUBLIC_URL=https://PromptWars.AIWeek.fun
